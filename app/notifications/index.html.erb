<h1>Ειδοποιήσεις</h1>

<% @notifications.each do |notification| %>
  <div style="<%= notification.read? ? 'opacity: 0.5;' : 'font-weight: bold;' %>">
    <%= notification.message_text %>
    <% unless notification.read? %>
      <%= button_to "Σήμανση ως αναγνωσμένο", mark_as_read_notification_path(notification), method: :patch %>
    <% end %>
  </div>
<% end %>