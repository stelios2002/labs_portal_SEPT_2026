<h1><%= @conversation.group ? @conversation.group.name : @conversation.users.where.not(id: current_user.id).first&.name %></h1>

<%= turbo_stream_from @conversation %>

<div id="messages">
  <%= render @messages %>
</div>

<%= form_with model: @message, url: conversation_messages_path(@conversation) do |f| %>
  <%= f.text_field :body, autocomplete: "off" %>
  <%= f.submit "Αποστολή" %>
<% end %>