<h1>Posts</h1>
<%= link_to "Νέο post", new_post_path, class: "btn" %>

<%= form_with url: posts_path, method: :get do %>
  <%= text_field_tag :q, params[:q], placeholder: "Αναζήτηση..." %>
  <%= select_tag :category_id,
        options_from_collection_for_select(Category.all, :id, :name, params[:category_id]),
        include_blank: "Όλες οι κατηγορίες" %>
  <%= submit_tag "Φίλτρο" %>
<% end %>

<% @posts.each do |post| %>
  <div class="row-card">
    <h3><%= link_to post.title, post %></h3>
    <p class="meta">
      από <%= post.user.name %> — <%= post.created_at.strftime("%d/%m/%Y") %>
      <% if post.categories.any? %>
        — <%= post.categories.map(&:name).join(", ") %>
      <% end %>
    </p>
  </div>
<% end %>