<h1>Κατηγορίες</h1>
<ul>
  <% @categories.each do |category| %>
    <li>
      <%= category.name %>
      <%= link_to "Επεξεργασία", edit_admin_category_path(category) %>
      <%= button_to "Διαγραφή", admin_category_path(category), method: :delete %>
    </li>
  <% end %>
</ul>
<%= link_to "Νέα κατηγορία", new_admin_category_path %>