<!DOCTYPE html>
<html>
  <head>
    <title>Labs Portal</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="page-header">
      <%= link_to "Labs Portal", (current_user ? posts_path : root_path), class: "brand" %>

      <nav>
        <% if current_user %>
          <%= link_to "Posts", posts_path %>
          <%= link_to "Ομάδες", groups_path %>
          <%= link_to "Συμφοιτητές", matches_path %>
          <%= link_to "Επαφές", contacts_path %>
          <div class="notification-badge" data-controller="notification-badge" data-notification-badge-count-value="<%= current_user.notifications.unread.count %>">
            <%= link_to notifications_path do %>
              🔔 <span data-notification-badge-target="count"><%= current_user.notifications.unread.count %></span>
            <% end %>
          </div>
          <%= link_to "Προφίλ", profile_path %>
          <%= button_to "Αποσύνδεση", destroy_user_session_path, method: :delete, class: "btn" %>
        <% elsif @admin_context %>
          <span class="meta">Admin</span>
        <% else %>
          <%= link_to "Σύνδεση", new_user_session_path %>
          <%= link_to "Εγγραφή", new_user_registration_path %>
        <% end %>
      </nav>
    </header>

    <div class="container">
      <% flash.each do |type, message| %>
        <div class="flash <%= type %>"><%= message %></div>
      <% end %>

      <%= yield %>
    </div>

    <% if current_user %>
      <div data-controller="chat-popup">
        <%= link_to "💬 Chat", conversations_path,
              data: { turbo_frame: "chat_popup_content" },
              class: "chat-toggle-btn" %>

        <div data-chat-popup-target="wrapper" class="chat-popup-panel" style="display: none;">
          <%= turbo_frame_tag "chat_popup_content", data: { chat_popup_target: "frame" } do %>
            <p class="meta">Επίλεξε μια συνομιλία.</p>
          <% end %>
        </div>
      </div>
    <% end %>
  </body>
</html>