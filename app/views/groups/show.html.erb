<h1><%= @group.name %></h1>
<p><%= @group.description %></p>

<h3>Μέλη</h3>
<ul>
  <% @group.users.each do |user| %>
    <li><%= link_to user.name, profile_path(user) %></li>
  <% end %>
</ul>

<% if @is_member %>
  <%= button_to "Αποχώρηση", leave_group_path(@group), method: :delete %>
<% else %>
  <%= button_to "Συμμετοχή", join_group_path(@group), method: :post %>
<% end %>