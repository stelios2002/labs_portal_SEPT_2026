<h1>Προτεινόμενοι συμφοιτητές</h1>

<% if @matches.any? %>
  <% @matches.each do |user| %>
    <div class="row-card">
      <h3><%= link_to user.name, profile_path(user) %></h3>
      <p class="meta">
        Κοινά μαθήματα: <%= (user.courses & current_user.courses).map(&:title).join(", ").presence || "—" %><br>
        Κοινά ενδιαφέροντα: <%= (user.interests & current_user.interests).map(&:name).join(", ").presence || "—" %>
      </p>
      <%= button_to "Προσθήκη επαφής", contacts_path(recipient_id: user.id), method: :post, class: "btn" %>
    </div>
  <% end %>
<% else %>
  <p>Δεν βρέθηκαν προτάσεις — πρόσθεσε μαθήματα/ενδιαφέροντα στο προφίλ σου.</p>
<% end %>